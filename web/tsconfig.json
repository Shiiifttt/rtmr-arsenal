{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The sim sources import each other with explicit .ts extensions so that
    // plain `node --test` can run them with no build step.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@sim": ["../sim/src/index.ts"], "@sim/*": ["../sim/src/*"] }
  },
  "include": ["src", "vite.config.ts", "../sim/src"]
}
